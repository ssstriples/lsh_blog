PORT=4100
NODE_ENV=development

# JWT (Access/Refresh는 반드시 서로 다른 값 사용)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Database
# Prisma Postgres를 쓰는 경우 아래와 같은 형태 (Prisma Console에서 발급)
DATABASE_URL=

# CORS (콤마로 여러 출처 구분 가능)
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
