# 백엔드 API 서버 주소 (Express, 기본 포트 4100)
NEXT_PUBLIC_API_URL=http://localhost:4100

# NextAuth v5 (Auth.js) — Credentials Provider로 백엔드 로그인 API를 감싸는 세션 관리
# openssl rand -base64 32 (또는 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") 로 생성
AUTH_SECRET=
AUTH_URL=http://localhost:3000
